---
// A row of big numbers with small labels above them.
interface Props {
  items: { label: string; value: string | number; unit?: string; note?: string }[];
  size?: number; // font size of the numbers in px (desktop)
  cols?: number;
}
const { items, size = 64, cols = items.length } = Astro.props;
---
<div class="stats" style={`--cols:${cols};--size:${size}px`}>
  {items.map((s) => (
    <div class="stat">
      <div class="label">{s.label}</div>
      <div class="big num">{s.value}{s.unit && <span class="unit">{s.unit}</span>}</div>
      {s.note && <div class="note">{s.note}</div>}
    </div>
  ))}
</div>

<style>
  .stats { display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); border-top: 2px solid var(--ink); }
  .stat { padding: 20px 16px 20px 0; border-bottom: 1px solid var(--line); }
  .num { font-size: clamp(36px, 6vw, var(--size)); margin-top: 8px; }
  .unit { font-size: 0.32em; letter-spacing: 0; margin-left: 4px; }
  .note { font-size: 15px; color: var(--muted); margin-top: 6px; }
  @media (max-width: 700px) { .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
