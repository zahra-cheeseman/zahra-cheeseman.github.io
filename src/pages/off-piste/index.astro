---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/data';
import { photosIn } from '../../lib/photos';

const posts = (await getCollection('offPiste')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const covers = await Promise.all(posts.map(async (p) => (await photosIn(`off-piste/${p.id}`))[0]));
---
<Base title="Off-piste" description="Innsbruck, minus the skiing.">
  <section class="wrap head">
    <h1>Off-piste</h1>
    <p class="lede">Innsbruck, minus the skiing. Mostly Kaiserschmarrn.</p>
  </section>
  <section class="wrap">
    <ul class="rule">
      {posts.map((p, i) => (
        <li>
          <a href={url(`/off-piste/${p.id}`)}>
            <span class="main">
              <span class="label">{p.data.category} · {p.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })}</span>
              <span class="title">{p.data.title}</span>
              <span class="summary">{p.data.summary}</span>
            </span>
            {covers[i] && <img src={covers[i]!.thumb} alt="" loading="lazy" />}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <style>
    .head { padding-block: 80px 48px; }
    .lede { margin: 20px 0 0; }
    ul { list-style: none; margin: 0; padding: 0; }
    li { border-bottom: 1px solid var(--line); }
    a { display: grid; grid-template-columns: minmax(0, 1fr) 160px; gap: 32px; align-items: center; padding: 28px 0; }
    .main { display: grid; gap: 6px; }
    .title { font-weight: 600; font-size: clamp(26px, 3.4vw, 40px); line-height: 1.05; letter-spacing: -0.035em; }
    .summary { font-size: 18px; color: #444; }
    img { width: 160px; aspect-ratio: 1; object-fit: cover; }
    @media (max-width: 600px) { a { grid-template-columns: 1fr 88px; gap: 16px; } img { width: 88px; } }
  </style>
</Base>
